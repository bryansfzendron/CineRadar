# Copie para .env e preencha. O .env nunca vai para o git.

# --- CineRadar ---
# Endereço que você usa para abrir o app (aparece nos webhooks).
CINERADAR_PUBLIC_URL=http://192.168.15.150:7575
# Primeiro usuário (criado só se o banco não tiver nenhum). Troque a senha depois em Ajustes.
CINERADAR_ADMIN_USER=admin
CINERADAR_ADMIN_PASSWORD=
# Segredo dos webhooks do Radarr/Sonarr (gere com: openssl rand -hex 24).
CINERADAR_WEBHOOK_TOKEN=
# Pasta do banco no host (docker-compose) e porta publicada.
CINERADAR_DATA_PATH=./data
CINERADAR_PORT=7575

# --- TMDB (títulos, sinopses, cartazes e listas em pt-BR) ---
# Chave v3 ou token de leitura v4: themoviedb.org > Configurações > API.
# Sem ela, a busca usa o Radarr/Sonarr e não há listas "em alta" / "nos cinemas".
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR

# --- Radarr / Sonarr ---
RADARR_URL=http://192.168.15.150:7878
RADARR_API_KEY=
RADARR_ROOT_FOLDER=/Movies
# Nome ou id do perfil de qualidade (vazio = o primeiro).
RADARR_QUALITY_PROFILE=
SONARR_URL=http://192.168.15.150:8989
SONARR_API_KEY=
SONARR_ROOT_FOLDER=/Series
SONARR_QUALITY_PROFILE=

# --- Prowlarr ---
PROWLARR_URL=http://192.168.15.150:9696
PROWLARR_API_KEY=

# --- Plex ---
PLEX_URL=http://192.168.15.150:32400
PLEX_TOKEN=
# Onde o navegador abre o Plex (padrão: app.plex.tv). Na rede local: http://192.168.15.150:32400/web/index.html
PLEX_WEB_URL=https://app.plex.tv/desktop

# --- Jellyfin ---
JELLYFIN_URL=http://192.168.15.150:8096
# Painel do Jellyfin > Chaves de API > +
JELLYFIN_API_KEY=
# Onde o navegador abre o Jellyfin (vazio = JELLYFIN_URL).
JELLYFIN_WEB_URL=

# --- qBittorrent (opcional: plano B quando o Radarr/Sonarr recusam um release) ---
QBITTORRENT_URL=http://192.168.15.150:9999
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=
QBITTORRENT_CATEGORY=cineradar
